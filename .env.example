# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter — used server-side only for the "Draft follow-up message" feature.
# Get a key from https://openrouter.ai/keys. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
